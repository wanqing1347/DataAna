# Copy to .env on the deployment host. Never commit the populated file.
DATAANA_PUBLIC_HOST=your-server-public-ip-or-domain
DATAANA_PORT=8889
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
JWT_SECRET=replace-with-a-long-random-jwt-secret
MINIO_PUBLIC_PORT=19000
MINIO_CONSOLE_PORT=19001
MYSQL_USER=dataana
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
MINIO_ACCESS_KEY=dataanaadmin
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_BUCKET_NAME=dataana-charts
DATA_AGENT_TOKEN_QUOTA_ENABLED=true
DATA_AGENT_TOKEN_QUOTA_DAILY_LIMIT=20000
DATA_AGENT_TOKEN_QUOTA_LIMITED_USERNAMES=analyst_test
