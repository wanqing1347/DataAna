DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/dataana?charset=utf8mb4
DEEPSEEK_API_KEY=your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=24

SCHEMA_PATH=../schema/DataAna.yml
SKILLS_DIR=../skills
ALLOWED_TABLES=actor,category,language,country,city,address,customer,film,inventory,rental,payment,film_actor,film_category,film_text,sys_user,sys_dept,sys_role,sys_user_role,sys_user_dept,user_profile
MAX_ROWS=200
MAX_JOINS=3

AGENT_MAX_TOOL_ROUNDS=100
AGENT_RECURSION_LIMIT=210
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=12000

CHECKPOINT_PATH=.data/langgraph_checkpoints.sqlite3
TOOL_RETRY_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_DELAY_MS=100

EXPLAIN_PRECHECK_ENABLED=true
EXPLAIN_PRECHECK_TIMEOUT_SECONDS=5
EXPLAIN_PRECHECK_MAX_ESTIMATED_ROWS=100000

DATA_PERMISSION_ENABLED=true
SENSITIVE_FILTER_ENABLED=true
SENSITIVE_FIELDS=sys_user.password,user_profile.id_card,user_profile.home_address

CHART_MCP_ENABLED=false
CHART_MCP_URL=http://localhost:3033/mcp

# Local benchmark endpoint only. Keep disabled in production.
BIRD_EVAL_ENABLED=false
BIRD_EVAL_TEMPERATURE=0.0
BIRD_EVAL_MAX_ROUNDS=50
BIRD_EVAL_SQL_TIMEOUT_SECONDS=20
BIRD_EVAL_TOOL_RESULT_MAX_ROWS=0
BIRD_EVAL_MAX_PROBE_CALLS=8
